{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProxyAuth": {
    "Enabled": true,
    "TrustProxyHeaders": true,
    "KnownNetworks": [
      "127.0.0.1",
      "::1"
    ],
    "HeaderNames": {
      "UserHeader": "X-Remote-User",
      "EmailHeader": "X-Remote-Email",
      "DisplayNameHeader": "X-Remote-Name"
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 2,
    "KnownNetworks": [
      "10.128.0.0/14"
    ]
  },
  "OpenShift": {
    "EnableForwardedHeaders": true,
    "ForwardedHeadersOptions": {
      "ForwardedHeaders": 7,
      "RequireHeaderSymmetry": false,
      "AllowedHosts": "*"
    }
  }
}
